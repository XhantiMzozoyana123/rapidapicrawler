# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Pp]ublish/
publish/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# User-specific files / VS
.vs/
*.user
*.suo
*.rsuser
*.sln.docstates

# Rider
.idea/

# Databases & local data
*.db
*.db-shm
*.db-wal
*.sqlite*

# Scraped data / exports
exports/

# Local LLM models — never commit multi-GB GGUF files (root-level ./models only)
/models/

# Logs & temp files
*.log
*.tmp
web-smoke*
report-smoke*

# Python helper scripts (used during dev, not part of the app)
*.py

# OS files
.DS_Store
Thumbs.db

# Secrets — never commit API keys or connection strings with real passwords
appsettings.*.json.user
.env
