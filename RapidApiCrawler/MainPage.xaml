<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RapidApiCrawler.MainPage"
             Title="RapidAPI Competitor Research">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20" RowSpacing="12">
        <HorizontalStackLayout Spacing="10">
            <Label Text="Keyword:"
                   VerticalOptions="Center" />
            <Entry x:Name="KeywordEntry"
                   Placeholder="e.g. instagram scraper"
                   WidthRequest="280"
                   Completed="OnStartClicked" />
            <Button x:Name="StartBtn"
                    Text="Start Crawl"
                    Clicked="OnStartClicked" />
            <CheckBox x:Name="AnalyzeCheck"
                      IsChecked="True"
                      VerticalOptions="Center" />
            <Label Text="AI gap analysis (Gemini)"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <HorizontalStackLayout Spacing="12">
                <Label Text="Headless browser" VerticalOptions="Center" />
                <Switch x:Name="HeadlessSwitch"
                        IsToggled="True"
                        Toggled="OnHeadlessToggled"
                        VerticalOptions="Center" />
                <Label x:Name="HeadlessHint" Text="(on: browser is hidden)" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel" Text="Ready." FontAttributes="Bold" />
        </VerticalStackLayout>

        <ProgressBar Grid.Row="2" x:Name="CrawlProgress" Progress="0" />

        <ScrollView Grid.Row="3">
            <Editor x:Name="LogEditor"
                    IsReadOnly="True"
                    AutoSize="TextChanges"
                    Placeholder="Crawl log will appear here..." />
        </ScrollView>

        <HorizontalStackLayout Grid.Row="4" Spacing="10">
            <Button Text="Download CSV" Clicked="OnDownloadCsvClicked" />
            <Button Text="View Database" Clicked="OnViewDatabaseClicked" />
            <Button Text="Show Last Report" Clicked="OnShowReportClicked" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
