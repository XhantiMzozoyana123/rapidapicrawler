@using RapidApiCrawler.Domain
@model TableResult
@{
    ViewData["Title"] = "Database";
    var tables = (List<string>)ViewBag.Tables!;
    var selected = (string?)ViewBag.SelectedTable;
}

<h4 class="mb-3">Database tables</h4>
<p class="mb-3">
    @foreach (var t in tables)
    {
        <span class="btn-group btn-group-sm me-1" role="group">
            <a asp-action="Index" asp-route-table="@t" class="btn @(t == selected ? "btn-primary" : "btn-outline-primary")">@t</a>
            <a asp-controller="Export" asp-action="Table" asp-route-table="@t" class="btn btn-outline-secondary" title="Download @(t).csv">⬇</a>
            <form asp-action="ClearTable" asp-route-table="@t" method="post" class="d-inline"
                  onsubmit="return confirm('Delete ALL rows from table @t? This cannot be undone.');">
                <button type="submit" class="btn btn-outline-danger" title="Delete all rows in @t">🗑</button>
            </form>
        </span>
    }
</p>

<div class="card border-danger mb-3">
    <div class="card-body py-2">
        <form asp-action="ClearAll" method="post" class="d-flex align-items-center gap-2"
              onsubmit="return confirm('Delete EVERY data record from ALL tables? This cannot be undone.');">
            <span class="text-danger fw-bold">Danger zone:</span>
            <button type="submit" class="btn btn-sm btn-danger">Delete ALL data</button>
            <span class="text-muted small">removes every row from every crawler table</span>
        </form>
    </div>
</div>

@if (TempData["ExportMessage"] is string em)
{
    <div class="alert alert-info">@em</div>
}

@if (Model.Columns.Length == 0)
{
    <p class="text-muted">No tables with data yet — run a crawl first.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    @foreach (var col in Model.Columns)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @foreach (var cell in row)
                        {
                            var text = cell switch
                            {
                                null => "(null)",
                                string s when s.Length > 120 => s[..120] + "…",
                                var v => v.ToString() ?? ""
                            };
                            <td style="max-width:300px; overflow-wrap:anywhere;">@text</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Showing @Model.Rows.Count row(s) (up to 300). Download the full CSV with the ⬇ button.</p>
}